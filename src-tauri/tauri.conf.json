{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Renitizer",
  "version": "0.1.0",
  "identifier": "com.renitizer.app",
  "build": {
    "beforeBuildCommand": "npm run build:native-web",
    "frontendDist": "../native-web"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Renitizer",
        "width": 1180,
        "height": 820,
        "minWidth": 390,
        "minHeight": 680
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "windows": {
      "signCommand": "powershell -NoProfile -ExecutionPolicy Bypass -File sign-windows.ps1 %1"
    }
  }
}
